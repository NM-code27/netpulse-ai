# Local dev default: a local SQLite file, zero setup required.
# For deployment, point this at your free Neon/Supabase Postgres connection string:
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./netpulse.db

# "ollama" for local free/offline dev, "groq" for the hosted demo (free tier).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Tuned so SIMULATOR_TICK_SECONDS * LIVE_SPEED_MULTIPLIER / 60 == 2.0 simulated
# minutes/tick, matching the historical training data's resolution.
LIVE_SPEED_MULTIPLIER=8
SIMULATOR_TICK_SECONDS=15
SCORING_INTERVAL_SECONDS=30
FORECAST_HORIZON_MINUTES=30

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
